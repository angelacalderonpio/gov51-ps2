predict(fit_q44,
newdata = data.frame(treated = c(1,0),
therm1 = c(50,50))
)
person_a = data.frame(treated = 1, therm1= 50)
person_b = data.frame(treated = 0, therm1 = 50)
predict(fit_44, newdata = person_a) - predict(fit_44, newdata = person_b)
